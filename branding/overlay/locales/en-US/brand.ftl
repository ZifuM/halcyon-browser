## Brand names. Generated from branding/overlay by `hx import`.
## -brand-product-name and -vendor-short-name stay "Firefox"/"Mozilla" on purpose:
## Firefox uses them for Mozilla services (e.g. "Mozilla account", "Firefox Sync"),
## which keep their real names.

-brand-shorter-name = {{NAME}}
-brand-short-name = {{NAME}}
-brand-shortcut-name = {{NAME}}
-brand-full-name = {{NAME}}
-brand-product-name = Firefox
-vendor-short-name = Mozilla
trademarkInfo = { " " }

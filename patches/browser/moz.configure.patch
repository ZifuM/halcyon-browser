diff --git a/browser/moz.configure b/browser/moz.configure
index ef7de8397fa9e2dbdf5256e025a947eadbef779d..7748934919bf15ec142cfa10f0593788f86f5df6 100644
--- a/browser/moz.configure
+++ b/browser/moz.configure
@@ -7,11 +7,17 @@ imply_option("MOZ_SERVICES_HEALTHREPORT", True)
 imply_option("MOZ_SERVICES_SYNC", True)
 imply_option("MOZ_DEDICATED_PROFILES", True)
 imply_option("MOZ_BLOCK_PROFILE_DOWNGRADE", True)
-imply_option("MOZ_NORMANDY", True)
+# Normandy (remote experiments and studies) is not enabled: the browser must not change
+# its own behaviour based on instructions fetched from a server. Normandy.init is behind
+# #ifdef MOZ_NORMANDY in browser/components/BrowserComponents.manifest.
 imply_option("MOZ_PROFILE_MIGRATOR", True)
 
 
 imply_option("MOZ_APP_VENDOR", "Mozilla")
+# Report the browser as Firefox in the user agent ("... Gecko/20100101 Firefox/158.0"). With
+# another app name, Gecko replaces the Firefox token with that name and sites such as Google and
+# YouTube treat the browser as outdated. Identical to Firefox is also better for privacy.
+imply_option("MOZ_APP_UA_NAME", "Firefox")
 imply_option("MOZ_APP_ID", "{ec8030f7-c20a-464f-9b0e-13a3a9e97384}")
 # Include the DevTools client, not just the server (which is the default)
 imply_option("MOZ_DEVTOOLS", "all")

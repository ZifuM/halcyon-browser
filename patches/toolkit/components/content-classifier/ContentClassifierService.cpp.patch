+// Peryn Shield: element hiding. Synchronous: each lookup is a few hash
+// probes in already-built engines (about 0.1 ms with the default lists).
+NS_IMETHODIMP ContentClassifierService::GetCosmeticResources(
+    const nsACString& aUrl, bool aPrivateBrowsing,
+    nsTArray<nsCString>& aHideSelectors,
+    nsTArray<nsCString>& aProceduralActions, nsTArray<nsCString>& aExceptions,
+    nsACString& aInjectedScript, bool* aGenericHide) {
+  NS_ENSURE_ARG_POINTER(aGenericHide);
+  MOZ_ASSERT(NS_IsMainThread());
+  *aGenericHide = false;
+  if (!IsInitialized()) {
+    return NS_ERROR_NOT_INITIALIZED;
+  }
+  MutexAutoLock lock(mLock);
+  const auto& engines = aPrivateBrowsing ? mCancelEnginesPBM : mCancelEngines;
+  for (const auto& engine : engines) {
+    bool genericHide = false;
+    nsAutoCString script;
+    if (NS_SUCCEEDED(engine->UrlCosmeticResources(
+            aUrl, aHideSelectors, aProceduralActions, aExceptions, script,
+            &genericHide))) {
+      *aGenericHide = *aGenericHide || genericHide;
+      aInjectedScript.Append(script);
+    }
+  }
+  return NS_OK;
+}
+
+NS_IMETHODIMP ContentClassifierService::GetHiddenClassIdSelectors(
+    bool aPrivateBrowsing, const nsTArray<nsCString>& aClasses,
+    const nsTArray<nsCString>& aIds, const nsTArray<nsCString>& aExceptions,
+    nsTArray<nsCString>& aSelectors) {
+  MOZ_ASSERT(NS_IsMainThread());
+  if (!IsInitialized()) {
+    return NS_ERROR_NOT_INITIALIZED;
+  }
+  MutexAutoLock lock(mLock);
+  const auto& engines = aPrivateBrowsing ? mCancelEnginesPBM : mCancelEngines;
+  for (const auto& engine : engines) {
+    (void)engine->HiddenClassIdSelectors(aClasses, aIds, aExceptions,
+                                         aSelectors);
+  }
+  return NS_OK;
+}
 

# The Arc-style window layout (C3): design tokens, sidebar sections, top bar, compact mode.
# Stylesheets ship next to the modules (moz-src:///browser/components/halcyon/layout/), which
# find them relative to themselves.

MOZ_SRC_FILES += [
    "halcyon-compact.css",
    "halcyon-layout.css",
    "halcyon-tokens.css",
    "HalcyonCompact.sys.mjs",
    "HalcyonLayout.sys.mjs",
    "HalcyonLayoutLogic.sys.mjs",
    "HalcyonSections.sys.mjs",
]

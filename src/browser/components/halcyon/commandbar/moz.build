# The command bar. omni_index.wasm is built from crates/omni-index by
# tools/omni/build_wasm.py before the build (it is not checked in).

MOZ_SRC_FILES += [
    "halcyon-commandbar.css",
    "HalcyonCommandBar.sys.mjs",
    "HalcyonCommandIndex.sys.mjs",
    "HalcyonCommandLogic.sys.mjs",
    "HalcyonShortcuts.sys.mjs",
    "omni_index.wasm",
    "OmniIndex.sys.mjs",
]

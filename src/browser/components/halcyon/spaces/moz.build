# Spaces (C4): named, coloured groups of tabs with their own Pinned tabs and optional container,
# synced through Firefox Sync. Created per window by ../layout/HalcyonLayout.sys.mjs.

MOZ_SRC_FILES += [
    "halcyon-grain.svg",
    "halcyon-spaces.css",
    "HalcyonSpaces.sys.mjs",
    "HalcyonSpacesLogic.sys.mjs",
    "HalcyonSpacesStore.sys.mjs",
    "HalcyonSpacesUI.sys.mjs",
]

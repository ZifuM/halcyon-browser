# Home of the browser's own components (src/, not patches). Hooked into the build by
# patches/browser/components/moz.build.patch. Modules load from
# moz-src:///browser/components/halcyon/<file>.

DIRS += ["shield"]

with Files("**"):
    BUG_COMPONENT = ("Firefox", "General")

MOZ_SRC_FILES += [
    "HalcyonBuildInfo.sys.mjs",
    "HalcyonUpdateLogic.sys.mjs",
    "HalcyonUpdates.sys.mjs",
]

EXTRA_COMPONENTS += [
    "halcyon.manifest",
]


# Spaces (C4): named, coloured groups of tabs with their own Pinned tabs and optional container,
# synced through Firefox Sync. Created per window by ../layout/PerynLayout.sys.mjs.

MOZ_SRC_FILES += [
    "peryn-grain.svg",
    "peryn-spaces.css",
    "PerynSpaces.sys.mjs",
    "PerynSpacesLogic.sys.mjs",
    "PerynSpacesStore.sys.mjs",
    "PerynSpacesUI.sys.mjs",
]

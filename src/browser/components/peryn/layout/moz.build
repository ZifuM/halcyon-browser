# The Arc-style window layout (C3): design tokens, sidebar sections, top bar, compact mode.
# Stylesheets ship next to the modules (moz-src:///browser/components/peryn/layout/), which
# find them relative to themselves.

MOZ_SRC_FILES += [
    "peryn-compact.css",
    "peryn-layout.css",
    "peryn-tokens.css",
    "PerynCompact.sys.mjs",
    "PerynLayout.sys.mjs",
    "PerynLayoutLogic.sys.mjs",
    "PerynMotion.sys.mjs",
    "PerynSections.sys.mjs",
]

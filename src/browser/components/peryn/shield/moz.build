# Shield: the built-in ad and tracker blocker. Network blocking is done by Firefox's content
# classifier (toolkit/components/content-classifier, adblock-rust) from the lists ShieldLists
# downloads; element hiding by the ShieldCosmetic actor, using the same engines.

MOZ_SRC_FILES += [
    "ShieldCosmetic.sys.mjs",
    "ShieldCosmeticChild.sys.mjs",
    "ShieldCosmeticLogic.sys.mjs",
    "ShieldCosmeticParent.sys.mjs",
    "ShieldListLogic.sys.mjs",
    "ShieldLists.sys.mjs",
]
